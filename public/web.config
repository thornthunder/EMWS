<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for EMWS. Vite copies this file into dist/, so deploying is just
  copying dist/ to the site folder. See docs/deploy-iis.md.

  EMWS is a purely static site: no application pool code, no URL Rewrite module
  (routing is hash-based), no server-side state.

  Every <remove> before an <add>/<mimeMap> is deliberate: IIS answers with a 500 if
  an entry is already defined at server level, and that varies between IIS versions.
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- WebAssembly must be served as application/wasm for streaming compilation. -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
      <remove fileExtension=".nec" />
      <mimeMap fileExtension=".nec" mimeType="text/plain" />
      <!-- Default for everything outside assets/: always revalidate. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" />
    </staticContent>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <!--
          Same-origin only. 'wasm-unsafe-eval' permits compiling the NEC2 WebAssembly
          engine (and nothing else); 'unsafe-inline' styles are React style attributes.
        -->
        <!--
          connect-src also allows a NEC solver running on the visitor's own machine. Any
          other solver is reached through solver/index.php on this site, which is
          'self' and so needs no exception here.
        -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Vite puts a content hash in every file name under assets/, so they can be cached forever. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
